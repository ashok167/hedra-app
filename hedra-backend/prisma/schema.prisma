generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}


model User {
  id        String   @id @default(uuid())
  name      String   @default("Admin") 
  email     String   @unique
  password  String
  role      Role     @default(ADMIN)
  createdAt DateTime @default(now())
}


enum Role {
  ADMIN
}

model Product {
  id          String   @id @default(uuid())
  name        String
  description String
  category    String
  tags        String[]
  price       String
  imageUrl    String
  specifications Json? 
  customizations Json?
  bestSeller     Boolean  @default(false)
  createdAt   DateTime @default(now())
}


model ContactMessage {
  id        String   @id @default(uuid())
  name      String
  email     String
  phone     String
  message   String
  createdAt DateTime @default(now())
}

enum CatalogueType {
  CHAIR_CATALOGUE
  UPHOLSTERY
  BRAND_LOGO
}

model Catalogue {
  id           String        @id @default(uuid())
  code         String        @unique        // e.g. CT001, CT002 ...
  type         CatalogueType
  name         String
  imageUrl     String                     // cover/swatch/logo image
  pdfUrl       String?                    // brochure/spec (not required for BRAND_LOGO)
  brandLogoUrl String?                    // optional brand logo image
  createdAt    DateTime      @default(now())
}

model Project {
 id           String @id @default(uuid())
  projectType String   // Home | Office
  title       String
  description String
  imageUrl       String
  year        String?
  client      String?

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("projects")
}

model Blog {
  id          Int      @id @default(autoincrement())
  title       String
  slug        String   @unique
  author      String
  tag         String?
  content     String
  isPublished Boolean  @default(true)

  images      String[]

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}


model Testimonial {
  id          Int      @id @default(autoincrement())
  clientName  String
  designation String
  company     String
  message     String
  isPublished Boolean  @default(true)

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}